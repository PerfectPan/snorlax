#!/bin/sh
# S1 launcher (plan 3.11). Batch 4 replaces the node -e line with
# Contents/Resources/collector/snorlax.mjs.
# Node comes from <data>/node-path when that file names an executable,
# otherwise from /opt/homebrew/bin:/usr/local/bin:/usr/bin. The login shell
# and PATH are not searched; the app writes node-path (Batch 4).
set -eu

data_dir() {
  if [ -n "${SNORLAX_HOME:-}" ]; then
    printf '%s\n' "$SNORLAX_HOME"
  else
    printf '%s\n' "$HOME/Library/Application Support/snorlax"
  fi
}

node_from_file() {
  data=$1
  if [ ! -f "$data/node-path" ]; then
    return 1
  fi
  candidate=$(head -n 1 "$data/node-path" | tr -d '\r')
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  return 1
}

node_from_fixed_dirs() {
  for dir in /opt/homebrew/bin /usr/local/bin /usr/bin; do
    if [ -x "$dir/node" ]; then
      printf '%s\n' "$dir/node"
      return 0
    fi
  done
  return 1
}

DATA=$(data_dir)
if ! NODE=$(node_from_file "$DATA"); then
  if ! NODE=$(node_from_fixed_dirs); then
    echo "snorlax: node not found (checked node-path, then /opt/homebrew/bin:/usr/local/bin:/usr/bin)" >&2
    exit 1
  fi
fi

mkdir -p "$DATA"
# One-line stand-in for the collector. Writes <data>/spike-run.json.
exec "$NODE" -e 'const fs=require("fs");const path=require("path");const dir=process.argv[1];fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(path.join(dir,"spike-run.json"),JSON.stringify({ok:true})+"\n");' "$DATA"
