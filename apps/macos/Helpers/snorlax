#!/bin/sh
# Launcher (plan 3.11). Node comes from <data>/node-path when that file
# names an executable, otherwise from /opt/homebrew/bin:/usr/local/bin:/usr/bin.
# The app writes node-path. This script does not search PATH or a login shell.
# It execs the collector bundled at Contents/Resources/collector/snorlax.mjs.
set -eu

data_dir() {
  if [ -n "${SNORLAX_HOME:-}" ]; then
    printf '%s\n' "$SNORLAX_HOME"
  else
    printf '%s\n' "$HOME/Library/Application Support/snorlax"
  fi
}

node_from_file() {
  data=$1
  if [ ! -f "$data/node-path" ]; then
    return 1
  fi
  candidate=$(head -n 1 "$data/node-path" | tr -d '\r')
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  return 1
}

node_from_fixed_dirs() {
  for dir in /opt/homebrew/bin /usr/local/bin /usr/bin; do
    if [ -x "$dir/node" ]; then
      printf '%s\n' "$dir/node"
      return 0
    fi
  done
  return 1
}

DATA=$(data_dir)
if ! NODE=$(node_from_file "$DATA"); then
  if ! NODE=$(node_from_fixed_dirs); then
    echo "snorlax: node not found (checked node-path, then /opt/homebrew/bin:/usr/local/bin:/usr/bin)" >&2
    exit 1
  fi
fi

HELPER=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
BUNDLE=$(CDPATH= cd -- "$HELPER/../.." && pwd)
COLLECTOR="$BUNDLE/Contents/Resources/collector/snorlax.mjs"
if [ ! -f "$COLLECTOR" ]; then
  echo "snorlax: bundled collector is missing at $COLLECTOR" >&2
  exit 1
fi
exec "$NODE" "$COLLECTOR" "$@"
