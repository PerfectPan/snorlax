{
  "name": "@rivus/snorlax-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "snorlax wire shapes: zod definitions of the bucket, snapshot and CLI outputs, with JSON Schema and sample fixture exports. Private; bundled into its users.",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node scripts/generate.ts && node scripts/generate-swift.ts",
    "generate:swift": "node scripts/generate-swift.ts",
    "lint": "vp lint 2>&1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test 2>&1",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@perfectpan/lint-config": "catalog:",
    "@types/node": "catalog:",
    "quicktype": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
