{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "scannedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "records": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sync": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "unpaired",
            "revoked"
          ]
        },
        "pushed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pulled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ok",
        "state",
        "pushed",
        "pulled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "scannedAt",
    "records",
    "failures",
    "sync"
  ],
  "additionalProperties": false
}
