{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buckets": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string"
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cacheReadTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cacheWriteTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reasoningTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sessionsStarted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "costUsd": {
            "type": "number",
            "minimum": 0
          },
          "unpricedRequests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "deviceId",
          "hour",
          "agent",
          "model",
          "inputTokens",
          "cacheReadTokens",
          "cacheWriteTokens",
          "outputTokens",
          "reasoningTokens",
          "requests",
          "sessionsStarted",
          "costUsd",
          "unpricedRequests"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "buckets"
  ],
  "additionalProperties": false
}
