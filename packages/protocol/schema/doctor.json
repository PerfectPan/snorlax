{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "healthy": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "error"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "healthy",
    "checks"
  ],
  "additionalProperties": false
}
