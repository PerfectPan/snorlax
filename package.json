{
  "name": "snorlax",
  "private": true,
  "description": "Private workspace root for snorlax: pnpm counts it as a workspace project; it publishes nothing and holds the pnpm -r shortcuts for the repository.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "changeset": "changeset",
    "check": "pnpm run format:check && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "duplicates": "jscpd --config node_modules/@perfectpan/lint-config/jscpd.json packages scripts --ignore '**/node_modules/**,**/dist/**,**/coverage/**,**/*.json,**/*.test.ts' --format 'typescript'",
    "duplicates:audit": "jscpd --config node_modules/@perfectpan/lint-config/jscpd-audit.json packages scripts --absolute --output tmp/duplicates-audit --ignore '**/node_modules/**,**/dist/**,**/coverage/**,**/*.json' --format 'typescript'",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "knip": "knip",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "version-packages": "changeset version"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "^26.13.1",
        "onFail": "error"
      }
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@perfectpan/lint-config": "catalog:",
    "jscpd": "5.4.2",
    "knip": "6.45.1"
  }
}
