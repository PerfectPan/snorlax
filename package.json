{
  "name": "snorlax",
  "private": true,
  "description": "Private workspace root for snorlax: pnpm counts it as a workspace project; it publishes nothing and holds the pnpm -r shortcuts for the repository.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "change": "pnpm change",
    "check": "pnpm run format:check && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "version-packages": "pnpm version -r",
    "release:check": "node scripts/check-release.ts",
    "publish:dry-run": "pnpm publish -r --access public --no-git-checks --dry-run --json"
  },
  "engines": {
    "node": "^24.22.0"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "^24.22.0",
        "onFail": "error"
      }
    ]
  }
}
