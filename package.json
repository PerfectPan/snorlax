{
  "name": "snorlax",
  "private": true,
  "description": "Private workspace root for snorlax: pnpm counts it as a workspace project; it publishes nothing and holds the pnpm -r shortcuts for the repository.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check": "pnpm run format:check && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test && node scripts/check-release-plan.mjs"
  },
  "engines": {
    "node": "^24.22.0"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "^24.22.0",
        "onFail": "error"
      }
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@changesets/get-release-plan": "5.0.2",
    "@changesets/should-skip-package": "1.0.0",
    "@manypkg/get-packages": "3.1.0"
  }
}
